{
  "name": "@delebash/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Vue LLM provider/prompt/usage UI for JustVoice + JustWrite. Plain JS + Vue SFCs, consumed via a Vite alias to src/; the views call the same server endpoints both apps mount and ship their own token-driven styles.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "test": "vitest run",
    "check:pickers": "node scripts/check-shared-pickers.js",
    "dup": "npx --yes jscpd@5",
    "lint": "biome check src",
    "i18n:lint": "eslint -c eslint.i18n.config.js \"src/**/*.{js,vue}\"",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.?(js|vue)\" --languageFiles \"src/i18n/locales/en.json\""
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/number": "^3.6.9",
    "@vueuse/core": "^15.0.0",
    "dom-accessibility-api": "^0.7.1",
    "dompurify": "^3.4.17",
    "front-matter": "^4.0.2",
    "marked": "^18.1.0",
    "pinia": "^4.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.35.0",
    "vue": "^3.5",
    "vue-i18n": "^11.4",
    "vue-router": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/compat": "^2.1.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "dompurify": "^3.4.17",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "front-matter": "^4.0.2",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n-extract": "^2.0.7"
  },
  "dependencies": {
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/spline-sans": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0"
  }
}
