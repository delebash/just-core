{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["src/**/*.{js,vue}"]
  },
  "javascript": {
    "globals": [
      "defineProps",
      "defineEmits",
      "defineExpose",
      "defineOptions",
      "defineModel",
      "withDefaults"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUndeclaredVariables": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": false
  }
}
