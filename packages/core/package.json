{
  "name": "@delebash/core",
  "version": "0.1.0",
  "private": true,
  "description": "The family's shared server kit in JavaScript — the LLM stack (providers, routing, presets, prompts, usage), the bundled llama.cpp runner and the platform pieces (errors, the spawn door, the data folder, backup). Mounted by each app's Hono server with installLlm. The JavaScript port of llm_runner (docs: JustVoice docs/plans/2026-10-07-electron-node-plan.md §4).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#runner/lifecycle": {
      "browser": "./src/runner/lifecycle.phone.js",
      "default": "./src/runner/lifecycle.js"
    },
    "#llm/chatgpt_signin": {
      "browser": "./src/llm/chatgpt_signin.phone.js",
      "default": "./src/llm/chatgpt_signin.js"
    }
  },
  "exports": {
    "./llm": "./src/llm/index.js",
    "./platform": "./src/platform/index.js",
    "./llm/*": "./src/llm/*.js",
    "./runner/*": "./src/runner/*.js",
    "./platform/*": "./src/platform/*.js",
    "./shell": "./src/shell/main.js",
    "./shell/preload": "./src/shell/preload.js",
    "./shell/*": "./src/shell/*.js"
  },
  "scripts": {
    "test": "node scripts/node24.js node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/node24.js node_modules/vitest/vitest.mjs",
    "lint": "biome check src tests scripts"
  },
  "allowScripts": {
    "electron": true,
    "koffi": true,
    "better-sqlite3": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/busboy": "^3.2.5",
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "@noble/hashes": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "cross-spawn": "^7.0.6",
    "electron-context-menu": "^5.1.0",
    "electron-updater": "^6.8.11",
    "hono": "^4.13.17",
    "koffi": "^3.3.7",
    "node-osc": "^11.7.1",
    "openai": "^7.53.0",
    "openid-client": "^6.8.9",
    "proper-lockfile": "4.1.2",
    "typebox": "^1.4.6",
    "undici": "^8.12.4",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "electron": "45.2.3",
    "vitest": "^5.1.0"
  }
}
