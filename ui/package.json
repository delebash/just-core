{
  "name": "@delebash/llm-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Vue LLM provider/prompt/usage UI for JustVoice + JustWrite. Plain JS + Vue SFCs, consumed via a Vite alias to src/; the views call the same server endpoints both apps mount and ship their own token-driven styles.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "check:pickers": "node scripts/check-shared-pickers.js",
    "dup": "npx --yes jscpd@5",
    "lint": "biome check src",
    "i18n:lint": "eslint -c eslint.i18n.config.js \"src/**/*.vue\"",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.?(js|vue)\" --languageFiles \"src/i18n/locales/*.json\""
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "vue": "^3.5",
    "quasar": "^2.35.0",
    "pinia": "^4.0",
    "vue-i18n": "^11.4",
    "marked": "^18.1.0",
    "@vueuse/core": "^15.0.0",
    "vue-router": "^5.4.0",
    "@floating-ui/dom": "^1.8.0",
    "qrcode": "^1.5.4"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "eslint": "^10.12.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n-extract": "^2.0.7"
  }
}
